{
  "name": "lyra",
  "version": "0.1.0",
  "description": "Lyra — Minimalist Local-First AI Workspace & Knowledge Studio",
  "private": true,
  "scripts": {
    "dev": "node scripts/warnOpenAccess.mjs && next dev -H 127.0.0.1 -p 3000",
    "dev:lan": "node scripts/warnOpenAccess.mjs --lan && next dev -H 0.0.0.0 -p 3000",
    "dev:all": "node scripts/launch.mjs dev",
    "dev:all:lan": "node scripts/launch.mjs dev:lan",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "node scripts/warnOpenAccess.mjs && next start -H 127.0.0.1 -p 3000",
    "start:lan": "node scripts/warnOpenAccess.mjs --lan && next start -H 0.0.0.0 -p 3000",
    "start:all": "node scripts/launch.mjs start",
    "prod:all": "npm run build && node scripts/launch.mjs start",
    "prod:all:lan": "npm run build && node scripts/launch.mjs start:lan",
    "tunnel": "node scripts/tunnel.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/jszip": "^3.4.0",
    "@types/katex": "^0.16.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "clsx": "^2.1.1",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.2",
    "katex": "^0.16.11",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
